- name: voronoi
  type: table
  desc: Creates bounded two-dimensional Voronoi diagrams using jc_voronoi 0.10.0.

  members:
  - name: create
    type: function
    desc: Creates a reusable Voronoi diagram context for a rectangular area.
    parameters:
    - name: width
      type: number
      desc: Width of the diagram bounds in coordinate units.
    - name: height
      type: number
      desc: Height of the diagram bounds in coordinate units.
    returns:
    - name: diagram
      type: userdata
      desc: Diagram context passed to the other voronoi functions.
    examples:
    - desc: local diagram = voronoi.create(800, 600)

  - name: destroy
    type: function
    desc: Releases a diagram context. Do not use the context after destroying it.
    parameters:
    - name: diagram
      type: userdata
      desc: Diagram context returned by voronoi.create().
    examples:
    - desc: voronoi.destroy(diagram)

  - name: generate
    type: function
    desc: Replaces the diagram with sites generated from a flat list of x/y coordinates. Duplicate sites may be removed.
    parameters:
    - name: diagram
      type: userdata
      desc: Diagram context returned by voronoi.create().
    - name: points
      type: table
      desc: Flat coordinate array in the form { x1, y1, x2, y2, ... }.
    examples:
    - desc: voronoi.generate(diagram, { 100, 100, 400, 300, 700, 500 })

  - name: relax
    type: function
    desc: Moves every input point toward the average of its site and cell vertices, then regenerates the diagram.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    examples:
    - desc: voronoi.relax(diagram)

  - name: get_sites
    type: function
    desc: Returns every generated site. A site contains p, index, boundary, edges, and the convenience field area. The p field is { x, y }; index is the 1-based original input index; boundary reports whether the cell touches the clipping boundary; and edges contains counter-clockwise edge tables.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: sites
      type: table
      desc: Array of site tables.
    examples:
    - desc: for _, site in ipairs(voronoi.get_sites(diagram)) do pprint(site) end

  - name: get_num_sites
    type: function
    desc: Returns diagram.numsites, the number of unique generated sites. This may be smaller than the input count when points are duplicated.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: count
      type: number
      desc: Number of unique generated sites.

  - name: get_site
    type: function
    desc: Returns the generated site for a 1-based original input index. The site has the same fields as entries returned by get_sites().
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    - name: index
      type: number
      desc: 1-based original input point index.
    returns:
    - name: site
      type: table
      desc: Site table for the requested input point.
    examples:
    - desc: local site = voronoi.get_site(diagram, 1)

  - name: get_num_vertices
    type: function
    desc: Returns diagram.numvertices, the number of unique Voronoi vertices.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: count
      type: number
      desc: Number of unique vertices.

  - name: get_vertices
    type: function
    desc: Returns all unique Voronoi vertices as { x, y } point tables. Edge vertex indices refer to this array.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: vertices
      type: table
      desc: Array of point tables.

  - name: get_edges
    type: function
    desc: Returns every diagram edge. Each edge contains sites, pos, and vertices. sites contains two 1-based input indices, with 0 denoting the clipping boundary. pos contains two { x, y } endpoints. vertices contains two 1-based indices into get_vertices(), with 0 denoting an invalid endpoint.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: edges
      type: table
      desc: Array of edge tables.

  - name: get_delauney_edges
    type: function
    desc: Returns the Delauney edges produced by the upstream jcv_delauney iterator. Each entry contains edge, sites, and pos fields matching jcv_delauney_edge. The upstream spelling "delauney" is preserved in the Lua function name.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: edges
      type: table
      desc: Array of Delauney edge tables.

  - name: get_debug_image
    type: function
    desc: Rasterizes the current diagram into an RGB buffer matching the context dimensions.
    parameters:
    - name: diagram
      type: userdata
      desc: Generated diagram context.
    returns:
    - name: image
      type: userdata
      desc: Buffer with a uint8 rgb stream containing three components per pixel.
    examples:
    - desc: resource.set_texture(texture, texture_header, voronoi.get_debug_image(diagram))
